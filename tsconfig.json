{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "types": ["bun"]
  },
  "include": ["index.ts", "index.pi.ts", "src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"]
}
